# ===== ACL da borda: cada identidade só acessa o mínimo necessário =====
# Dispositivos (usuário = CN do certificado individual)
pattern write va/+/%u/tele
pattern read va/+/%u/cmd
pattern read va/+/%u/sim

# ---- espaço cc ----
user edge-rules-cc
topic read va/cc/+/tele
topic write va/cc/+/cmd
topic write va/cc/alarme
topic read va/cc/config
user sync-cc
topic write va/cc/config
user lab-injetor-cc
topic write va/cc/+/sim

