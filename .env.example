# Copie para .env (opcional). Nenhum segredo aqui: senhas e chaves são geradas
# por scripts/gen-secrets.sh dentro de ./secrets (ignorado pelo Git).
COMPOSE_PROJECT_NAME=va-cloud
# Diretório da CA raiz OFFLINE (fora do repositório)
ROOT_CA_DIR=${HOME}/va-ca-raiz-offline
# Nível de paranoia do WAF (OWASP CRS). 2 = projeto; baixe para 1 se houver falso positivo
WAF_PARANOIA=2
